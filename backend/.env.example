DATABASE_URL="postgresql://user:password@localhost:5432/multiatendimento"
JWT_SECRET="troque-por-uma-chave-segura"
PORT=3002
FRONTEND_URL="http://localhost:5174"
PUBLIC_URL="http://localhost:3002"
DEFAULT_EVOLUTION_URL=""
DEFAULT_EVOLUTION_KEY=""
# Segredo compartilhado que valida a origem das chamadas do webhook da Evolution
# (viaja como ?secret= na URL registrada na instância). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem essa variável o webhook aceita requisições sem validar origem (modo compatível).
EVOLUTION_WEBHOOK_SECRET=""
GEMINI_CHAT_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"
GEMINI_LIGHT_MODELS="gemini-2.5-flash-lite,gemini-2.5-flash"
GEMINI_MULTIMODAL_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"
# OpenAI (alternativa ao Gemini — melhor para transcrição em PT-BR)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o"
OPENAI_EMBED_MODEL="text-embedding-3-small"
# Tempo para agrupar mensagens consecutivas antes de a IA responder.
BOT_REPLY_DEBOUNCE_MS=500
# Tempo em que o WhatsApp exibe o indicador "digitando...".
BOT_TYPING_DURATION_MS=5000
# Evita que uma chamada instavel da OpenAI deixe o atendimento preso.
OPENAI_REQUEST_TIMEOUT_MS=30000
OS_CONFIRMATION_TIMEOUT_MS=30000
PUBLIC_CALCULATOR_TENANT_SLUG="crm-juridico"
APP_TIMEZONE="America/Sao_Paulo"
UPLOADS_PATH="./uploads"
LEGAL_DOCUMENTS_PATH="./uploads/legal-documents"
# E-mail transacional opcional via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pedro Bastos Lund <contato@seudominio.com.br>"
# Monitoramento de movimentação processual (DataJud/CNJ). Chave pública
# gratuita: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=""
DATAJUD_BASE_URL="https://api-publica.datajud.cnj.jus.br"
# Provedor de OAuth do Decap CMS (/admin do site institucional). OAuth App
# criado em https://github.com/settings/applications/new, com Authorization
# callback URL = <PUBLIC_URL>/api/cms-auth/callback.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
