# URL pública do backend. Em desenvolvimento, deixe vazio para usar o proxy do Vite.
VITE_API_URL=""

# Opcional: os sites públicos enviam erros técnicos mínimos para o monitor.
# Em produção, use a URL pública da API se o site estiver em outro domínio.
VITE_PUBLIC_MONITOR_ENABLED="true"

# Número em formato internacional, somente para os links da landing pública.
VITE_LANDING_WHATSAPP="5551999999999"
